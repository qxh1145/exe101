generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  role             Role             @default(USER)
  major            String?
  year             Int?
  age              Int?
  onboardingStatus OnboardingStatus @default(PENDING)
  currentSessionId String?
  wallet           Wallet?
  publishedSurveys Survey[]         @relation("Publisher")
  sessions         SurveySession[]
  fraudLogs        FraudLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum OnboardingStatus {
  PENDING
  COMPLETED
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  cachedBalance  Int           @default(0)
  pendingBalance Int           @default(0)
  ledgerEntries  LedgerEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model LedgerEntry {
  id        String            @id @default(uuid())
  walletId  String
  wallet    Wallet            @relation(fields: [walletId], references: [id])
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  amount    Int
  surveyId  String?
  survey    Survey?           @relation(fields: [surveyId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum TransactionType {
  STARTER_LOCKED_RELEASE
  STARTER_UNLOCKED
  PUBLISH_SURVEY_ESCROW
  SURVEY_REWARD_PENDING
  SURVEY_REWARD_SETTLED
  ESCROW_REFUND
}

enum TransactionStatus {
  PENDING
  SETTLED
  DISPUTED
  FAILED
}

model Survey {
  id             String          @id @default(uuid())
  publisherId    String
  publisher      User            @relation("Publisher", fields: [publisherId], references: [id])
  title          String
  url            String
  completionCode String
  targetCount    Int
  bounty         Int
  estimatedTime  Int // in minutes
  targetMajor    String?
  targetYear     Int?
  targetAgeMin   Int?
  targetAgeMax   Int?
  status         SurveyStatus    @default(ACTIVE)
  expiresAt      DateTime
  sessions       SurveySession[]
  ledgerEntries  LedgerEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum SurveyStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
}

model SurveySession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  surveyId  String
  survey    Survey        @relation(fields: [surveyId], references: [id])
  startTime DateTime      @default(now())
  endTime   DateTime?
  status    SessionStatus @default(IN_PROGRESS)
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model FraudLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  surveyId  String
  reason    String
  createdAt DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value String
}
